# Cognitive Kitchen - environment variable template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- Hosted model: contrast runs + Ragas/DeepEval judge ---
OPENAI_API_KEY=

# --- LangSmith tracing of the LCEL chains ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cognitive-kitchen

# --- Models. Every one is swappable here; no code change needed. ---
# Small by design: this runs on CPU. On a GPU machine, raise them.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
JUDGE_MODEL=gpt-4o-mini

# --- API ---
# 8010 rather than 8000: another process holds 8000 on the dev machine.
API_HOST=127.0.0.1
API_PORT=8010

# --- Sample sizes while proving the pipeline ---
EVAL_RETRIEVAL_QUESTIONS=20
EVAL_GENERATION_QUESTIONS=5

# --- Knowledge graph: Neo4j Aura ---
# Take all of these verbatim from the Aura credentials dotenv file you
# downloaded when the instance was created. Do not assume defaults:
# on this project's instance USERNAME and DATABASE are both the instance id,
# not the literal "neo4j". Verified by live connection test.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=
NEO4J_DATABASE=<instance-id>
AURA_INSTANCEID=<instance-id>
AURA_INSTANCENAME=
